pipeline {
    agent any

    stages {
        // 【关键改动】必须在进入任何 stage 之前，用 script 块注入参数
        stage('Init Params') {
            steps {
                script {
                    properties([
                        parameters([
                            choice(name: 'ENV', choices: ['audit', 'test', 'release', 'prod'], description: '环境'),
                            string(name: 'VERSION', defaultValue: '', description: '版本号，如 v1.2.3'),
                            string(name: 'BRANCH', defaultValue: 'main', description: '分支（TAG 为空时生效）'),
                            string(name: 'TAG', defaultValue: '', description: 'Tag（非空时优先，按 tag 检出）'),
                            [
                                $class: 'DynamicReferenceParameter',
                                name: 'SERVERS',
                                description: '服务器（复选框，可多选）',
                                choiceType: 'ET_CHECKBOXES', // 复选框
                                referencedParameters: '',
                                script: [
                                    $class: 'GroovyScript',
                                    fallbackScript: [classpath: [], sandbox: true, script: 'return []'],
                                    // 注意：这里的 return 语句一定要是纯 Groovy 列表
                                    script: [classpath: [], sandbox: true, script: "return ['gate-1', 'game-1', 'battle-1', 'social-1', 'login-1', 'admin-1']"]
                                ]
                            ]
                        ])
                    ])
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    if (params.TAG?.trim()) {
                        // 按 tag 拉取本次发布版本代码
                        checkout([$class: 'GitSCM',
                                  branches: [[name: "refs/tags/${params.TAG}"]],
                                  userRemoteConfigs: scm.userRemoteConfigs])
                    } else {
                        checkout scm
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    // 将多选的 List 转换为空格分隔的字符串，例如："gate-1 game-1"
                    def servers = (params.SERVERS instanceof List) ? params.SERVERS.join(' ') : (params.SERVERS ?: '')
                    if (!servers) {
                        error("请至少选择一台服务器 (SERVERS 不能为空)")
                    }
                    sh 'bash deploy/scripts/build.sh --env "$ENV" --version "$VERSION" --servers "$servers"'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def servers = (params.SERVERS instanceof List) ? params.SERVERS.join(' ') : (params.SERVERS ?: '')
                    sh 'bash deploy/cicd/deploy.sh --env "$ENV" --version "$VERSION" --servers "$servers"'
                }
            }
        }
    }

    post {
        success {
            script {
                if (params.VERSION?.trim()) {
                    archiveArtifacts artifacts: "dist/${params.ENV}/${params.VERSION}/*.tar.gz", fingerprint: true
                }
            }
        }
    }
}