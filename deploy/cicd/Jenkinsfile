def resolvedVersion = ''
def resolvedServers = ''

// ========== Jenkins 凭据（需在 Credentials 页面预先创建好） ==========
// EXCEL_CREDENTIALS_ID：Username/Password 类型，复用检出 server-cluster 已成功使用的 cnb 凭据
// DEPLOY_CREDENTIALS_ID：SSH Private Key 类型，用于 scp/ssh 到 servers.conf 里列的目标机
def EXCEL_GIT_URL = 'https://cnb.cool/nightcatgames/excelconfig.git'
def EXCEL_CREDENTIALS_ID = 'cnb'
def DEPLOY_CREDENTIALS_ID = 'deploy-ssh-key'

// 归一化服务器列表：兼容 Extended Choice 返回空格分隔 / 用户手填逗号分隔 / 多余空格
def normalizedServers(raw) {
    return (raw ?: '').trim().replace(',', ' ').replaceAll(/\s+/, ' ')
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 2, unit: 'HOURS')
    }

    parameters {
        // ========== 构建来源（二选一） ==========
        choice(
            name: 'BUILD_SOURCE',
            choices: ['branch', 'tag'],
            description: '构建来源：branch=从分支构建并配版本号；tag=按 tag 检出（版本号自动取 tag 名）'
        )

        string(name: 'BRANCH',  defaultValue: 'master', description: '分支（BUILD_SOURCE=branch 时生效）')
        string(name: 'TAG',     defaultValue: '',        description: 'Tag    （BUILD_SOURCE=tag 时生效，如 v1.0.0）')
        string(name: 'VERSION', defaultValue: '',        description: '版本号 vX.Y.Z（BUILD_SOURCE=branch 时必填；tag 模式自动取 tag 名）')

        // ========== 发布目标 ==========
        choice(name: 'ENV', choices: ['test', 'audit', 'release', 'prod'], description: '部署环境')

        // ========== 服务器 ==========
        extendedChoice(
            name: 'SERVERS',
            description: '服务器（按住 Ctrl/Shift 多选；空=该环境 servers.conf 全部）',
            type: 'PT_MULTI_SELECT',
            value: '',
            multiSelectDelimiter: ' ',
            visibleItemCount: 7
        )

        // ========== 执行控制 ==========
        booleanParam(name: 'RUN_DEPLOY', defaultValue: true, description: '执行 Deploy；关闭则只 Config+Build，不发版')
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                script {
                    if (params.BUILD_SOURCE == 'tag') {
                        checkout([$class: 'GitSCM',
                                  branches: [[name: "refs/tags/${params.TAG.trim()}"]],
                                  userRemoteConfigs: scm.userRemoteConfigs])
                    } else {
                        def branch = params.BRANCH.trim() ?: 'master'
                        checkout([$class: 'GitSCM',
                                  branches: [[name: "*/${branch}"]],
                                  userRemoteConfigs: scm.userRemoteConfigs])
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    def source = params.BUILD_SOURCE
                    def env    = params.ENV
                    def tag    = params.TAG?.trim() ?: ''
                    def ver    = params.VERSION?.trim() ?: ''

                    // --- 版本号（严格校验） ---
                    if (source == 'tag') {
                        if (!tag) error('BUILD_SOURCE=tag 时 TAG 必填')
                        resolvedVersion = tag
                    } else {
                        if (!ver) error('BUILD_SOURCE=branch 时 VERSION 必填')
                        resolvedVersion = ver
                    }

                    // --- 服务器列表（空 = 从 servers.conf 里解析该环境全部） ---
                    def rawServers = normalizedServers(params.SERVERS)
                    if (rawServers) {
                        resolvedServers = rawServers
                    } else {
                        // 用 shell + awk 读 workspace 里的 servers.conf（不碰 controller 文件系统）
                        def serversFromConf = sh(
                            script: "awk 'NF && !/^#/ {print \$1}' deploy/cicd/${env}/servers.conf",
                            returnStdout: true
                        ).trim()
                        resolvedServers = serversFromConf
                    }
                    if (!resolvedServers) error('SERVERS 为空，且 servers.conf 里也没找到服务器')

                    // --- 运行计划 ---
                    echo """
                    === 运行计划 ===
                    构建来源 : ${source}
                    检出     : ${source == 'tag' ? "tag ${tag}" : "branch ${params.BRANCH}"}
                    版本号   : ${resolvedVersion}
                    环境     : ${env}
                    服务器   : ${resolvedServers}
                    部署     : ${params.RUN_DEPLOY ? '是' : '否（只打包）'}
                    """
                }
            }
        }

        stage('Config') {
            steps {
                script {
                    sh '''
                        set +e
                        echo "=== tool check ==="
                        for tool in dotnet go bash git chmod; do
                            if command -v "$tool" >/dev/null 2>&1; then
                                printf '  %-8s -> %s\\n' "$tool" "$(command -v "$tool")"
                            else
                                printf '  %-8s -> MISSING\\n' "$tool"
                            fi
                        done
                        echo
                        if command -v dotnet >/dev/null 2>&1; then
                            dotnet --list-runtimes 2>/dev/null | head -5
                        fi
                        set -e
                    '''
                    def versionArg = (params.ENV in ['release', 'prod']) ? "--version '${resolvedVersion}'" : ''
                    withCredentials([usernamePassword(
                        credentialsId: EXCEL_CREDENTIALS_ID,
                        usernameVariable: 'EXCEL_GIT_USER',
                        passwordVariable: 'EXCEL_GIT_PASS'
                    )]) {
                        sh """
                            set -e
                            chmod +x deploy/scripts/*.sh deploy/tools/Luban/luban.sh 2>/dev/null || true
                            bash deploy/scripts/gen-config.sh --env '${params.ENV}' ${versionArg}
                        """
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh "bash deploy/scripts/build.sh --env '${params.ENV}' --version '${resolvedVersion}' --servers '${resolvedServers}'"
                }
            }
        }

        stage('Deploy') {
            when { expression { params.RUN_DEPLOY } }
            steps {
                script {
                    withCredentials([sshUserPrivateKey(
                        credentialsId: DEPLOY_CREDENTIALS_ID,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            set -e
                            mkdir -p ~/.ssh && chmod 700 ~/.ssh
                            eval "\$(ssh-agent -s)"
                            trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
                            ssh-add "\$SSH_KEY"
                            # known_hosts 存到 workspace 本地，首次用 ssh-keyscan 预加，不绕 host key 校验
                            mkdir -p \$WORKSPACE/.ssh && chmod 700 \$WORKSPACE/.ssh
                            touch \$WORKSPACE/.ssh/known_hosts && chmod 644 \$WORKSPACE/.ssh/known_hosts
                            for host in \$(awk 'NF && !/^#/ {print \$2}' deploy/cicd/${params.ENV}/servers.conf | sort -u); do
                                ssh-keyscan -H "\$host" 2>/dev/null >> \$WORKSPACE/.ssh/known_hosts || true
                            done
                            export DEPLOY_SSH_OPTS="-o UserKnownHostsFile=\$WORKSPACE/.ssh/known_hosts"
                            bash deploy/cicd/deploy.sh --env '${params.ENV}' --version '${resolvedVersion}' --servers '${resolvedServers}' --user "\$SSH_USER"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                archiveArtifacts artifacts: "dist/${params.ENV}/${resolvedVersion}/*.tar.gz", fingerprint: true
            }
        }
    }
}
