// ============================================================
// Jenkinsfile — 全环境通用
//   ENV=test/audit  → branch 模式（BRANCH + 手动 VERSION）
//   ENV=release/prod → tag 模式（TAG 即 VERSION）
// ============================================================

def EXCEL_CREDENTIALS_ID = 'cnb'
def DEPLOY_CREDENTIALS_ID = 'deploy-ssh-key'

def DEFAULT_SERVERS = [
    'test':    'gate-1 game-1 login-1 admin-1',
    'audit':   'gate-1 game-1 login-1 admin-1',
    'release': 'gate-1 game-1 login-1 admin-1',
    'prod':    'gate-1 game-1 login-1 admin-1',
]

def env = params.ENV
def servers = (params.SERVERS?.trim() ?: '').replace(',', ' ').replaceAll(/\s+/, ' ')
if (!servers) servers = DEFAULT_SERVERS[env]

// 根据 ENV 决定构建模式和版本号
def isTagMode = (env in ['release', 'prod'])
def resolvedVersion
def checkoutRef

if (isTagMode) {
    resolvedVersion = params.TAG.trim()
    checkoutRef     = "refs/tags/${resolvedVersion}"
} else {
    resolvedVersion = params.VERSION.trim()
    checkoutRef     = "*/${params.BRANCH.trim() ?: 'master'}"
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 2, unit: 'HOURS')
    }

    parameters {
        choice(name: 'ENV',     choices: ['test', 'audit', 'release', 'prod'], description: '环境')

        // branch 模式用
        string(name: 'BRANCH',  defaultValue: 'master', description: '分支（test/audit 时生效）')
        string(name: 'VERSION', defaultValue: '',        description: '版本号 vX.Y.Z（test/audit 必填；release/prod 自动取 TAG）')

        // tag 模式用
        string(name: 'TAG',     defaultValue: '',        description: 'Tag（release/prod 时必填；同时作为版本号）')

        extendedChoice(
            name: 'SERVERS',
            description: '服务器（按住 Ctrl/Shift 多选；空=默认全部）',
            type: 'PT_MULTI_SELECT',
            value: 'gate-1,game-1,battle-1,social-1,login-1,admin-1',
            multiSelectDelimiter: ' ',
            visibleItemCount: 7
        )
        booleanParam(name: 'RUN_DEPLOY', defaultValue: true, description: '执行 Deploy；关闭则只 Config+Build')
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([$class: 'GitSCM',
                          branches: [[name: checkoutRef]],
                          userRemoteConfigs: scm.userRemoteConfigs])
            }
        }

        stage('Validate') {
            steps {
                script {
                    if (isTagMode) {
                        if (!resolvedVersion) error('release/prod 环境 TAG 必填')
                    } else {
                        if (!resolvedVersion) error('test/audit 环境 VERSION 必填')
                    }
                    echo """
                    === 运行计划 ===
                    模式     : ${isTagMode ? 'tag' : 'branch'}
                    检出     : ${checkoutRef}
                    版本号   : ${resolvedVersion}
                    环境     : ${env}
                    服务器   : ${servers}
                    部署     : ${params.RUN_DEPLOY ? '是' : '否'}
                    """
                }
            }
        }

        stage('Config') {
            steps {
                script {
                    def versionArg = isTagMode ? "--version '${resolvedVersion}'" : ''
                    withCredentials([usernamePassword(
                        credentialsId: EXCEL_CREDENTIALS_ID,
                        usernameVariable: 'EXCEL_GIT_USER',
                        passwordVariable: 'EXCEL_GIT_PASS'
                    )]) {
                        sh """
                            set -e
                            chmod +x deploy/scripts/*.sh deploy/tools/Luban/luban.sh 2>/dev/null || true
                            bash deploy/scripts/gen-config.sh --env '${env}' ${versionArg}
                        """
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh "bash deploy/scripts/build.sh --env '${env}' --version '${resolvedVersion}' --servers '${servers}'"
            }
        }

        stage('Deploy') {
            when { expression { params.RUN_DEPLOY } }
            steps {
                script {
                    withCredentials([sshUserPrivateKey(
                        credentialsId: DEPLOY_CREDENTIALS_ID,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            set -e
                            mkdir -p ~/.ssh && chmod 700 ~/.ssh
                            eval "\$(ssh-agent -s)"
                            trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
                            ssh-add "\$SSH_KEY"
                            mkdir -p \$WORKSPACE/.ssh && chmod 700 \$WORKSPACE/.ssh
                            touch \$WORKSPACE/.ssh/known_hosts && chmod 644 \$WORKSPACE/.ssh/known_hosts
                            for host in \$(awk 'NF && !/^#/ {print \$2}' deploy/cicd/${env}/servers.conf | sort -u); do
                                ssh-keyscan -H "\$host" 2>/dev/null >> \$WORKSPACE/.ssh/known_hosts || true
                            done
                            export DEPLOY_SSH_OPTS="-o UserKnownHostsFile=\$WORKSPACE/.ssh/known_hosts"
                            bash deploy/cicd/deploy.sh --env '${env}' --version '${resolvedVersion}' --servers '${servers}' --user "\$SSH_USER"
                        """
                    }
                }
            }
        }
    }

    post {
        success { archiveArtifacts artifacts: "dist/${env}/${resolvedVersion}/*.tar.gz", fingerprint: true }
    }
}
