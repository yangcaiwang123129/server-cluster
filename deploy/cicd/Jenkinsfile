// ============================================================
// Jenkinsfile — 全环境通用
//   test       → VERSION 可空（空则 branch-构建号 自动生成）
//   audit      → VERSION 必填
//   release/prod → VERSION 必填，作为 tag 检出（VERSION 就是 tag 名）
//   脚本里统一用 VERSION 变量
// ============================================================

def EXCEL_CREDENTIALS_ID = 'cnb'
def DEPLOY_CREDENTIALS_ID = 'deploy-ssh-key'

def DEFAULT_SERVERS = [
    'test':    'gate-1 game-1 login-1 admin-1',
    'audit':   'gate-1 game-1 login-1 admin-1',
    'release': 'gate-1 game-1 login-1 admin-1',
    'prod':    'gate-1 game-1 login-1 admin-1',
]

def env = params.ENV
def isTagMode = (env in ['release', 'prod'])

// 版本号统一用 params.VERSION（release/prod 下就是 tag 名）
def version = params.VERSION?.trim()
def branch  = params.BRANCH?.trim() ?: 'master'

def resolvedVersion
def checkoutRef

if (isTagMode) {
    if (!version) error("${env} 环境 VERSION 必填（VERSION 即 tag 名）")
    resolvedVersion = version
    checkoutRef     = "refs/tags/${version}"
} else {
    if (env == 'audit' && !version) error('audit 环境 VERSION 必填')
    resolvedVersion = version ?: "${branch}-${currentBuild.number}"
    checkoutRef     = "*/${branch}"
}

def servers = (params.SERVERS?.trim() ?: '').replace(',', ' ').replaceAll(/\s+/, ' ')
if (!servers) servers = DEFAULT_SERVERS[env]

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 2, unit: 'HOURS')
    }

    parameters {
        choice(name: 'ENV', choices: ['test', 'audit', 'release', 'prod'], description: '环境')
        string(name: 'BRANCH',  defaultValue: 'master', description: '分支（release/prod 时忽略）')
        string(name: 'VERSION', defaultValue: '',        description: '版本号（test 可空=自动生成；audit/release/prod 必填）')
        extendedChoice(
            name: 'SERVERS',
            description: '服务器（按住 Ctrl/Shift 多选）',
            type: 'PT_MULTI_SELECT',
            value: 'gate-1,game-1,battle-1,social-1,login-1,admin-1',
            multiSelectDelimiter: ' ',
            visibleItemCount: 7
        )
        booleanParam(name: 'RUN_DEPLOY', defaultValue: true, description: '执行 Deploy；关闭则只 Config+Build')
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([$class: 'GitSCM',
                          branches: [[name: checkoutRef]],
                          userRemoteConfigs: scm.userRemoteConfigs])
            }
        }

        stage('Validate') {
            steps {
                echo """
                === 运行计划 ===
                模式     : ${isTagMode ? 'tag' : 'branch'}
                检出     : ${checkoutRef}
                VERSION  : ${resolvedVersion}
                环境     : ${env}
                服务器   : ${servers}
                部署     : ${params.RUN_DEPLOY ? '是' : '否'}
                """
            }
        }

        stage('Config') {
            steps {
                script {
                    def versionArg = isTagMode ? "--version '${resolvedVersion}'" : ''
                    withCredentials([usernamePassword(
                        credentialsId: EXCEL_CREDENTIALS_ID,
                        usernameVariable: 'EXCEL_GIT_USER',
                        passwordVariable: 'EXCEL_GIT_PASS'
                    )]) {
                        sh """
                            set -e
                            chmod +x deploy/scripts/*.sh deploy/tools/Luban/luban.sh 2>/dev/null || true
                            bash deploy/scripts/gen-config.sh --env '${env}' ${versionArg}
                        """
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh """
                    echo "[Build] SERVERS 原始值: '${servers}'"
                    bash deploy/scripts/build.sh --env '${env}' --version '${resolvedVersion}' ${servers}
                """
            }
        }

        stage('Deploy') {
            when { expression { params.RUN_DEPLOY } }
            steps {
                script {
                    withCredentials([sshUserPrivateKey(
                        credentialsId: DEPLOY_CREDENTIALS_ID,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            set -e
                            mkdir -p ~/.ssh && chmod 700 ~/.ssh
                            eval "\$(ssh-agent -s)"
                            trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
                            ssh-add "\$SSH_KEY"
                            mkdir -p \$WORKSPACE/.ssh && chmod 700 \$WORKSPACE/.ssh
                            touch \$WORKSPACE/.ssh/known_hosts && chmod 644 \$WORKSPACE/.ssh/known_hosts
                            for host in \$(awk 'NF && !/^#/ {print \$2}' deploy/cicd/${env}/servers.conf | sort -u); do
                                ssh-keyscan -H "\$host" 2>/dev/null >> \$WORKSPACE/.ssh/known_hosts || true
                            done
                            export DEPLOY_SSH_OPTS="-o UserKnownHostsFile=\$WORKSPACE/.ssh/known_hosts"
                            echo "[Deploy] SERVERS 原始值: '${servers}'"
                            bash deploy/cicd/deploy.sh --env '${env}' --version '${resolvedVersion}' ${servers} --user "\$SSH_USER"
                        """
                    }
                }
            }
        }
    }

    post {
        success { archiveArtifacts artifacts: "dist/${env}/${resolvedVersion}/*.tar.gz", fingerprint: true }
    }
}
