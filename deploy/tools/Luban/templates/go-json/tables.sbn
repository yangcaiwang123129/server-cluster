{{~if __namespace != ''~}}
package {{__namespace}}

{{~end~}}

{{~
    func table_field_name
        ret (string.replace $0 "Cfg" "")
    end
~}}

import (
	"encoding/json"
	"fmt"
	"sync"
)

// Table 是配置表的泛型容器：按 id 建 map，同时保留原始顺序的 list。
// 构造后只读，支持并发读。
type Table[T any] struct {
	dataMap  map[int32]*T
	dataList []*T
}

// Get 按 id 查询，不存在返回 nil。
func (t *Table[T]) Get(id int32) *T { return t.dataMap[id] }

// Has 判断 id 是否存在。
func (t *Table[T]) Has(id int32) bool {
	_, ok := t.dataMap[id]
	return ok
}

// Len 返回记录数。
func (t *Table[T]) Len() int { return len(t.dataMap) }

// GetDataMap 返回全部记录的 id→记录 map。
func (t *Table[T]) GetDataMap() map[int32]*T { return t.dataMap }

// GetDataList 返回按文件顺序排列的全部记录。
func (t *Table[T]) GetDataList() []*T { return t.dataList }

// Map 是 Luban json 导出的 map 容器：数据以 [key,value] 二元数组序列化，
// 这里在反序列化时还原为原生 map，字段用法与 map 一致。
type Map[K comparable, V any] map[K]V

// UnmarshalJSON 解析 [["k1","v1"],["k2","v2"]] 形式的 map 数据。
func (m *Map[K, V]) UnmarshalJSON(data []byte) error {
	var pairs [][2]json.RawMessage
	if err := json.Unmarshal(data, &pairs); err != nil {
		return err
	}
	out := make(map[K]V, len(pairs))
	for _, p := range pairs {
		var k K
		if err := json.Unmarshal(p[0], &k); err != nil {
			return err
		}
		var v V
		if err := json.Unmarshal(p[1], &v); err != nil {
			return err
		}
		out[k] = v
	}
	*m = out
	return nil
}

// LoadTable 读取内嵌的 <file>.json 加载一张表，keyFn 从记录中提取主键。
func LoadTable[T any](file string, keyFn func(*T) int32) (*Table[T], error) {
	raw, err := loadRaw(file)
	if err != nil {
		return nil, fmt.Errorf("cfg: read %s.json: %w", file, err)
	}
	var rows []*T
	if err := json.Unmarshal(raw, &rows); err != nil {
		return nil, fmt.Errorf("cfg: parse %s.json: %w", file, err)
	}
	tb := &Table[T]{
		dataList: rows,
		dataMap:  make(map[int32]*T, len(rows)),
	}
	for _, r := range rows {
		k := keyFn(r)
		if _, dup := tb.dataMap[k]; dup {
			// 同一 id 多行是合法数据（如关卡按波次分行），保留首条，不中断加载。
			continue
		}
		tb.dataMap[k] = r
	}
	return tb, nil
}

//------------------------------------------------------------------------------
// Tables 是配置表集合，自动由 Luban 生成。
//------------------------------------------------------------------------------

// Tables 持有全部配置表实例，由 Load 初始化。
type Tables struct {
{{~for table in __tables~}}
	{{table_field_name table.value_type}} *Table[{{table.value_type}}] // {{table.comment}}
{{~end~}}
}

var (
	tables *Tables
	loadMu sync.Mutex
	loaded bool
)

// Load 加载全部配置表；幂等（重复调用直接返回 nil）。
func Load() error {
	loadMu.Lock()
	defer loadMu.Unlock()
	if loaded {
		return nil
	}
	t := &Tables{}
	var err error
{{~for table in __tables~}}
	if t.{{table_field_name table.value_type}}, err = LoadTable("{{table.output_data_file}}", func(r *{{table.value_type}}) int32 { return r.Id }); err != nil {
		return err
	}
{{~end~}}
	tables = t
	loaded = true
	return nil
}

// MustLoad 同 Load，但失败直接 panic。
func MustLoad() {
	if err := Load(); err != nil {
		panic("cfg: MustLoad: " + err.Error())
	}
}

// T 获取全局配置表；须先 Load 成功，否则 panic。
func T() *Tables {
	if tables == nil {
		panic("cfg: T() called before Load()/MustLoad()")
	}
	return tables
}

// Loaded 是否已加载。
func Loaded() bool { return loaded }
