{{~if ___top_module != ''~}}
package {{__top_module}}

{{~end~}}

{{~
    go_full_name = full_name __this
    hierarchy_fields = __this.hierarchy_export_fields
~}}

type {{go_full_name}} struct {
    {{~for field in hierarchy_fields ~}}
    {{format_field_name __code_style field.name}} {{if field.ctype.is_map}}Map[{{declaring_type_name field.ctype.key_type}}, {{declaring_type_name field.ctype.value_type}}]{{else}}{{declaring_type_name field.ctype}}{{end}} `json:"{{field.name}}"`{{-if field.comment != ''}} // {{escape_comment field.comment}}{{end}}
    {{~end~}}
}
